"""Preview Ovygram control styles, adjust them locally and export a style draft."""

import asyncio
from functools import partial
import json
import re

from base_plugin import BasePlugin
from desktop import ui

__id__ = "palette_lab"
__name__ = "Палитра Ovygram"
__description__ = "Подбор цветов и скругления кнопок Ovygram с экспортом в JSON."
__author__ = "Ovygram"
__version__ = "1.1.0"
__release__ = False
__platform__ = "desktop"
__desktop_sdk__ = 4

# Only sample captions and layout live here. The native client supplies defaults.
BUTTONS = {
    "primary": "Выбрать сервер",
    "secondary": "Обновить список",
    "danger": "Остановить",
    "trash": "Корзина",
    "code": "192.0.2.42",
    "chip": "Telegram",
    "link": "Назначить маршруты",
    "choice": "По умолчанию",
    "selected_choice": "PROXY",
    "install": "Импортировать плагин",
    "subtle": "Проверить обновления",
    "install_secondary": "Установить с предупреждением",
    "settings_row": "Открыть журнал",
    "settings_link": "Настройки плагина",
    "save_settings": "Сохранить настройки",
    "file_details": "Подробности файла",
    "card_title": "Пример плагина",
    "card_action": "Отправить",
    "card_danger": "Удалить",
    "menu_action": "Выбрать версию",
    "menu_danger": "Удалить экземпляр",
    "proxy_selector": "По умолчанию  ⌄",
    "proxy_reset": "↶",
    "dialog": "Закрыть",
    "dialog_danger": "Сбросить все",
    "native_primary": "Готово",
    "cancel": "Отмена установки",
    "popup_item": "Прокси по умолчанию",
    "close": "Крестик диалога",
    "back": "Назад",
    "search_clear": "Очистить поиск",
}
LABELS = {
    "normal": "Основная надпись",
    "muted": "Приглушённая подпись",
    "accent": "Акцентная надпись",
    "positive": "Успешное состояние",
    "attention": "Предупреждение",
}
FIELDS = {
    "text": "Текст или иконка",
    "background": "Фон",
    "border": "Обводка",
    "hover_text": "Текст при наведении",
    "hover_background": "Фон при наведении",
    "ripple": "Эффект нажатия",
}
GROUPS = {
    "sdk": ("Кнопки SDK", (
        ("primary", "secondary", "danger", "trash"), ("code", "chip"),
        ("link",), ("choice", "selected_choice"),
    )),
    "plugins": ("Плагины", (
        ("install", "subtle"), ("install_secondary", "cancel"), ("card_title", "card_action", "card_danger"),
        ("settings_link", "file_details"), ("settings_row", "save_settings"), ("menu_action", "menu_danger"),
    )),
    "proxy": ("Прокси и меню", (
        ("proxy_selector", "proxy_reset"), ("dialog_danger", "dialog", "native_primary"),
        ("popup_item",), ("back", "close", "search_clear"),
    )),
}
HEX_COLOR = re.compile(r"#[0-9A-Fa-f]{6}")


def color_ok(value):
    return isinstance(value, str) and HEX_COLOR.fullmatch(value) is not None


def radius_ok(value):
    return type(value) is int and 0 <= value <= 64


class Editor:
    def __init__(self, plugin, palette):
        self.plugin = plugin
        self.palette = palette
        self.theme = palette["theme"]
        self.edits = plugin.get_setting("style_drafts", {})
        if not isinstance(self.edits, dict):
            self.edits = {}
        self.buttons, self.labels = self.restore_draft(self.edits.get(self.theme))
        self.role = "subtle"
        self.group = "plugins"
        self.field = "text"
        self.menu = None
        self.samples = {}
        self.groups = {}
        self.tabs = {}
        for group, (title, rows) in GROUPS.items():
            self.tabs[group] = ui.Button(title, partial(self.show_group, group), variant="choice",
                                         selected=group == self.group)
            self.groups[group] = ui.Card(
                *(ui.Row(*(self.make_sample(role) for role in roles), wrap=True) for roles in rows),
                *(self.label_samples() if group == "sdk" else ()),
                *(self.menu_entry() if group == "proxy" else ()),
                gap=4, visible=group == self.group,
            )
        self.role_picker = ui.Button(BUTTONS[self.role], self.choose_role, variant="subtle")
        self.field_picker = ui.Button(FIELDS[self.field], self.choose_field, variant="subtle")
        self.hex_input = ui.Input(on_change=self.enter_hex)
        self.hex_hint = ui.Text("", tone="attention")
        self.status = ui.Text("", tone="muted")
        self.slider_labels = [ui.Text("", width=80) for _ in range(3)]
        self.sliders = [ui.Slider(on_change=partial(self.set_channel, index), label=name)
                        for index, name in enumerate(("Красный", "Зелёный", "Синий"))]
        self.radius_label = ui.Text("", width=150)
        self.radius_slider = ui.Slider(on_change=self.set_radius, maximum=64, label="Скругление")
        self.radius_controls = ui.Column(
            ui.Row(self.radius_label, self.radius_slider),
            ui.Row(ui.Button("Применить ко всем кнопкам", self.apply_radius_to_all, variant="subtle", width="fit"),
                   ui.Button("Сбросить скругление", self.clear_radius, variant="dialog", width="fit"), wrap=True),
            gap=2, visible=True,
        )
        self.swatch = ui.Canvas(32, width=40)
        self.dialog = ui.Dialog(
            ui.Column(
                ui.Row(*self.tabs.values(), wrap=True),
                *self.groups.values(),
                ui.Card(
                    ui.Row(self.role_picker, self.field_picker, wrap=True),
                    ui.Row(ui.Text("HEX", width=80), self.hex_input, self.swatch),
                    *(ui.Row(label, slider) for label, slider in zip(self.slider_labels, self.sliders)),
                    self.hex_hint,
                    self.radius_controls,
                    ui.Row(ui.Button("Вернуть исходные значения", self.reset, variant="subtle", width="fit"),
                           self.status, wrap=True),
                    gap=3,
                ),
                gap=5,
            ),
            title=__name__, width=750,
            footer_action=ui.Button("Экспорт JSON", self.export),
        ).show()
        self.render_editor()

    @staticmethod
    def restore_draft(draft):
        buttons, labels = {}, {}
        if not isinstance(draft, dict):
            return buttons, labels
        button_data = draft.get("buttons", {})
        label_data = draft.get("labels", {})
        for role, value in (button_data if isinstance(button_data, dict) else {}).items():
            if role not in BUTTONS or not isinstance(value, dict):
                continue
            saved_colors = value.get("colors", {})
            colors = {key: color.upper() for key, color in
                      (saved_colors if isinstance(saved_colors, dict) else {}).items()
                      if key in FIELDS and color_ok(color)}
            radius = value.get("radius")
            styled = {"colors": colors} if colors else {}
            if radius_ok(radius):
                styled["radius"] = radius
            if styled:
                buttons[role] = styled
        for role, value in (label_data if isinstance(label_data, dict) else {}).items():
            if role in LABELS and color_ok(value):
                labels[role] = value.upper()
        return buttons, labels

    def make_sample(self, role, *, menu=False):
        spec = self.buttons.get(role, {})
        width = None if menu else {
            "install": "fit", "subtle": "fit", "install_secondary": "fit", "cancel": "fit",
            "card_title": "fit", "card_action": "fit", "card_danger": "fit",
            "settings_link": "fit", "file_details": "fit", "menu_action": "fit", "menu_danger": "fit",
            "trash": 42, "proxy_reset": 38, "back": 60, "close": 44, "search_clear": 44,
        }.get(role)
        selected = role == "selected_choice"

        def select():
            if menu:
                self.menu.close()
            self.select_role(role)

        sample = ui.Button(
            BUTTONS[role], select,
            variant="choice" if selected else role, selected=selected,
            detail="Подключён" if selected and menu else "",
            palette="ovygram", width=width, tooltip=BUTTONS[role],
            colors=spec.get("colors"), radius=spec.get("radius"),
        )
        if not menu:
            self.samples[role] = sample
        return sample

    def label_samples(self):
        for role, title in LABELS.items():
            self.samples[role] = ui.Text(title, tone=role, color=self.labels.get(role))
        return (ui.Row(
            ui.Column(*(self.samples[key] for key in ("normal", "muted", "accent")), gap=1),
            ui.Column(*(self.samples[key] for key in ("positive", "attention")), gap=1),
            align="top",
        ),)

    def menu_entry(self):
        return (ui.Row(ui.Button("Открыть пример меню", self.show_menu,
                                 variant="subtle", width="fit"), ui.Spacer(0)),)

    def show_group(self, group):
        self.group = group
        for key, node in self.groups.items():
            self.update(node, visible=key == group)
            self.update(self.tabs[key], selected=key == group)

    def current_color(self):
        if self.role in LABELS:
            return self.labels.get(self.role, self.palette["labels"][self.role])
        spec = self.palette["buttons"][self.role]["colors"]
        edits = self.buttons.get(self.role, {}).get("colors", {})
        default = spec.get(self.field)
        if default is None:
            default = self.palette["background"] if self.field in {"background", "hover_background"} else spec["text"]
        return edits.get(self.field, default)

    def current_radius(self):
        return self.buttons.get(self.role, {}).get("radius", self.palette["buttons"][self.role]["radius"])

    def update(self, node, **props):
        changed = {key: value for key, value in props.items() if node.props.get(key) != value}
        if changed:
            self.dialog.update(node, **changed)

    def render_editor(self, *, sync_input=True):
        color = self.current_color()
        button = self.role in BUTTONS
        self.update(self.role_picker, text=(BUTTONS | LABELS)[self.role])
        self.update(self.field_picker, text=FIELDS[self.field], enabled=button)
        if sync_input:
            self.update(self.hex_input, text=color)
        self.update(self.hex_hint, text="")
        self.update(self.swatch, commands=[ui.fill_rect(1, 1, 38, 30, color, radius=6)])
        for name, value, label, slider in zip(
            ("R", "G", "B"), bytes.fromhex(color[1:]), self.slider_labels, self.sliders,
        ):
            self.update(label, text=f"{name} {value}")
            self.update(slider, value=value)
        self.update(self.radius_controls, visible=button)
        if button:
            radius = self.current_radius()
            self.update(self.radius_label, text=f"Скругление · {radius} px")
            self.update(self.radius_slider, value=min(radius, 64))

    def choose(self, title, items, select):
        if self.menu and not self.menu.closed:
            return

        def pick(key):
            self.menu.close()
            select(key)

        self.menu = ui.Dialog(
            ui.Column(*(ui.Button(label, partial(pick, key), variant="choice") for key, label in items), gap=3),
            title=title, width=420,
        ).show()

    def choose_role(self):
        self.choose("Элемент палитры", (BUTTONS | LABELS).items(), self.select_role)

    def choose_field(self):
        self.choose("Что перекрасить", FIELDS.items(), self.select_field)

    def select_role(self, role):
        self.role = role
        self.field = "text"
        group = next((group for group, (_, rows) in GROUPS.items()
                      if any(role in row for row in rows)), "sdk")
        self.show_group(group)
        self.render_editor()

    def select_field(self, field):
        self.field = field
        self.render_editor()

    def sample_changed(self, role):
        if role in BUTTONS:
            spec = self.buttons.get(role, {})
            self.update(self.samples[role], colors=spec.get("colors", {}), radius=spec.get("radius"))
        else:
            self.update(self.samples[role], color=self.labels.get(role))
        self.update(self.status, text="")

    def apply(self, color, *, sync_input=True):
        if self.current_color() != color:
            if self.role in BUTTONS:
                self.buttons.setdefault(self.role, {}).setdefault("colors", {})[self.field] = color
            else:
                self.labels[self.role] = color
            self.sample_changed(self.role)
        self.render_editor(sync_input=sync_input)

    def enter_hex(self, value):
        if color_ok(value):
            self.apply(value.upper(), sync_input=False)
        else:
            self.update(self.hex_hint, text="Введите цвет в формате #RRGGBB.")

    def set_channel(self, channel, value):
        channels = bytearray.fromhex(self.current_color()[1:])
        channels[channel] = value
        self.apply("#" + channels.hex().upper())

    def set_radius(self, value):
        if self.role not in BUTTONS:
            return
        self.buttons.setdefault(self.role, {})["radius"] = value
        self.sample_changed(self.role)
        self.render_editor()

    def apply_radius_to_all(self):
        if self.role not in BUTTONS:
            return
        radius = self.current_radius()
        for role in BUTTONS:
            self.buttons.setdefault(role, {})["radius"] = radius
            self.sample_changed(role)
        self.update(self.status, text=f"Скругление {radius} px применено ко всем образцам.")

    def clear_radius(self):
        spec = self.buttons.get(self.role)
        if spec:
            spec.pop("radius", None)
            if not spec:
                self.buttons.pop(self.role)
        self.sample_changed(self.role)
        self.render_editor()

    def show_menu(self):
        if self.menu and not self.menu.closed:
            return
        self.menu = ui.Dialog(
            ui.Column(
                self.make_sample("popup_item", menu=True),
                self.make_sample("choice", menu=True),
                self.make_sample("selected_choice", menu=True),
                ui.Divider(),
                self.make_sample("menu_action", menu=True),
                self.make_sample("menu_danger", menu=True),
                gap=4,
            ),
            title="Пример меню", width=445,
        ).show()

    def reset(self):
        self.buttons.clear()
        self.labels.clear()
        for role in self.samples:
            self.sample_changed(role)
        self.render_editor()

    def export(self):
        draft = {
            "schema": "ovygram.palette.v2",
            "theme": self.theme,
            "buttons": self.buttons,
            "labels": self.labels,
        }
        self.edits[self.theme] = draft
        self.plugin.set_setting("style_drafts", self.edits)
        ui.set_clipboard(json.dumps(draft, ensure_ascii=False, indent=2))
        self.update(self.status, text="JSON скопирован в буфер обмена.")


class PaletteLab(BasePlugin):
    def on_plugin_load(self):
        self.editor = None
        self.opening = False
        ui.add_menu_item("main", __name__, self.open)

    async def open(self, _menu=None):
        if self.opening or (self.editor and not self.editor.dialog.closed):
            return
        if not hasattr(ui, "get_style_palette"):
            ui.show_dialog("Установите сборку Ovygram с каталогом стилей.", title=__name__)
            return
        self.opening = True
        try:
            palette = await asyncio.wait_for(ui.get_style_palette(), 5)
            self.editor = Editor(self, palette)
        except (RuntimeError, TimeoutError):
            ui.show_dialog("Не удалось загрузить стили клиента.", title=__name__)
        finally:
            self.opening = False
