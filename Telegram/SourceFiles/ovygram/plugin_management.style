using "ui/basic.style";
using "ui/widgets/widgets.style";
using "ui/layers/layers.style";

settingsPluginSwitch: Toggle(defaultToggle) {
	untoggledFg: menuIconFg;
}
settingsPluginSettingRow: SettingsButton(defaultSettingsButton) {
	toggle: settingsPluginSwitch;
	toggleOver: Toggle(settingsPluginSwitch) {
		untoggledFg: menuIconFgOver;
	}
	toggleSkip: 20px;
}
settingsPluginSave: SettingsButton(settingsPluginSettingRow) {
	textFg: lightButtonFg;
	textFgOver: lightButtonFgOver;
}
settingsPluginSelector: Checkbox(defaultBoxCheckbox) {
	textPosition: point(15px, 1px);
}
settingsPluginSelectorMargin: margins(22px, 5px, 10px, 5px);

settingsPluginCardMargin: margins(16px, 4px, 16px, 8px);
settingsPluginCardRadius: 10px;
settingsPluginsLayerWidth: 660px;
settingsPluginTextMargin: margins(16px, 0px, 16px, 8px);
settingsPluginSectionMargin: margins(16px, 10px, 16px, 8px);
settingsPluginSectionTitle: FlatLabel(defaultSubsectionTitle) {
	minWidth: 1px;
}
settingsPluginToggleWidth: 58px;
settingsPluginStatusDot: 8px;
settingsPluginStatusSkip: 8px;
settingsPluginBadgeGap: 6px;
settingsPluginBadgePadding: margins(10px, 4px, 10px, 4px);
settingsPluginBadgeWarning: icon {{ "levels/level_warning-16x16", attentionButtonFg }};
settingsPluginBadgeOfficial: windowActiveTextFg;
settingsPluginBadgeVerified: boxTextFgGood;
settingsPluginBadgeUnverified: attentionButtonFg;
settingsPluginBadgeOfficialHue: 210.;
settingsPluginBadgeVerifiedHue: 125.;
settingsPluginBadgeSaturationMin: 0.48;
settingsPluginBadgeSaturationMax: 0.72;
settingsPluginBadgeDarkLightnessMin: 0.60;
settingsPluginBadgeDarkLightnessMax: 0.72;
settingsPluginBadgeLightLightnessMin: 0.38;
settingsPluginBadgeLightLightnessMax: 0.46;
settingsPluginBadgeWarningSaturation: 0.62;
settingsPluginBadgeWarningLightness: 0.66;
settingsPluginBadgeLightTextBlend: 0.30;
settingsPluginBadgeTrustFillAlpha: 26;
settingsPluginBadgeNeutralFillAlpha: 16;
settingsPluginVersionFillAlpha: 0.18;
settingsPluginDividerAlpha: 0.08;
settingsPluginSecondaryTextBlend: 0.26;
settingsPluginCardAction: SettingsButton(settingsPluginSettingRow) {
	textFg: lightButtonFg;
	textFgOver: lightButtonFgOver;
	textBg: transparent;
	textBgOver: transparent;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: transparent;
	}
	padding: margins(16px, 10px, 16px, 10px);
	height: 20px;
}
settingsPluginToggleAction: SettingsButton(settingsPluginCardAction) {
	padding: margins(0px, 10px, 0px, 10px);
	toggleSkip: 14px;
	toggleOver: settingsPluginSwitch;
	toggle: settingsPluginSwitch;
}
settingsPluginCardTitle: SettingsButton(settingsPluginCardAction) {
	style: TextStyle(boxTextStyle) {
		font: font(14px semibold);
	}
	textFg: windowBoldFg;
	textFgOver: windowBoldFgOver;
}
settingsPluginCardRemove: SettingsButton(settingsPluginCardAction) {
	textFg: attentionButtonFg;
	textFgOver: attentionButtonFgOver;
}
settingsPluginMenuRow: SettingsButton(defaultSettingsButton) {
	padding: margins(68px, 10px, 16px, 10px);
	iconLeft: 32px;
}
settingsPluginMenuRemove: SettingsButton(settingsPluginMenuRow) {
	textFg: attentionButtonFg;
	textFgOver: attentionButtonFgOver;
}
settingsPluginFileIcon: icon {{ "menu/export", menuIconFg }};
settingsPluginRegistryIcon: icon {{ "menu/download", menuIconFg }};
settingsPluginRollbackIcon: icon {{ "menu/restore", menuIconFg }};
settingsPluginShareIcon: icon {{ "menu/forward", menuIconFg }};
settingsPluginRemoveIcon: icon {{ "menu/delete", attentionButtonFg }};
settingsPluginSettingsIcon: icon {{ "menu/settings", menuIconFg }};
settingsPluginLinkArrow: icon {{ "settings/premium/arrow", menuIconFg }};
settingsPluginLinkMargin: margins(16px, 0px, 16px, 6px);
settingsPluginLinkTextSkip: 2px;
settingsPluginLinkRow: SettingsButton(settingsPluginMenuRow) {
	padding: margins(52px, 10px, 36px, 10px);
	iconLeft: 16px;
	textBg: transparent;
	textBgOver: transparent;
	ripple: RippleAnimation(defaultRippleAnimation) {
		color: transparent;
	}
}
settingsPluginBody: FlatLabel(defaultFlatLabel) {
	minWidth: 1px;
	maxHeight: 0px;
	style: TextStyle(defaultTextStyle) {
		font: font(14px);
	}
}
settingsPluginCardMeta: FlatLabel(settingsPluginBody) {
	textFg: windowSubTextFg;
}
settingsPluginSettingHint: FlatLabel(settingsPluginSectionTitle) {
	textFg: windowSubTextFg;
}
settingsPluginStatus: FlatLabel(settingsPluginBody) {
	style: TextStyle(defaultTextStyle) {
		font: font(14px semibold);
		lineHeight: 20px;
	}
	textFg: windowBoldFg;
}
settingsPluginInstallTitle: FlatLabel(settingsPluginBody) {
	style: TextStyle(defaultTextStyle) {
		font: font(18px semibold);
	}
}

settingsPluginInstallBadge: FlatLabel(settingsPluginCardMeta) {
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
settingsPluginInstallRowMargin: margins(16px, 10px, 16px, 10px);
settingsPluginInstallRowGap: 12px;
settingsPluginInstallBadgeRadius: 6px;
settingsPluginInstallBadgePadding: margins(8px, 3px, 8px, 3px);
// Shared styles for Ovygram-owned actions. Inherited colors follow the theme.
settingsPluginActionRadius: 8px;
settingsPluginRowRadius: 6px;
settingsPluginLegacyCardActionRadius: 6;
settingsPluginProxyRadius: 7px;
settingsPluginChoiceHeight: 18px;
settingsPluginChipHeight: 24px;
settingsPluginChipWidth: -18px;
settingsPluginCodeHeight: 25px;
settingsPluginPrimary: RoundButton(defaultActiveButton) {
	radius: buttonRadius;
}
settingsPluginLight: RoundButton(defaultLightButton) {
	radius: buttonRadius;
}
settingsPluginDialog: RoundButton(defaultBoxButton) {
	radius: buttonRadius;
}
settingsPluginDialogDanger: RoundButton(settingsPluginDialog) {
	textFg: attentionButtonFg;
	textFgOver: attentionButtonFg;
}
settingsPluginInstallButton: RoundButton(settingsPluginPrimary) {
	radius: settingsPluginActionRadius;
}
settingsPluginInstallSecondary: RoundButton(settingsPluginLight) {
	radius: settingsPluginActionRadius;
	textBg: windowBgOver;
}
settingsPluginProxySelector: RoundButton(settingsPluginLight) {
	radius: settingsPluginProxyRadius;
	textBg: windowBgOver;
	textFg: windowFg;
	textFgOver: windowFgOver;
}
settingsPluginProxyReset: RoundButton(settingsPluginProxySelector) {
	textFg: windowSubTextFg;
	textFgOver: windowSubTextFg;
}
settingsPluginPopupText: windowFg;
settingsPluginPopupTextHover: windowFgOver;
settingsPluginPopupFill: windowBg;
settingsPluginPopupFillHover: windowBgOver;
settingsPluginPopupPadding: margins(17px, 8px, 17px, 7px);
settingsPluginPopup: PopupMenu(defaultPopupMenu) {
	menu: Menu(defaultMenu) {
		itemFg: settingsPluginPopupText;
		itemFgOver: settingsPluginPopupTextHover;
		itemBg: settingsPluginPopupFill;
		itemBgOver: settingsPluginPopupFillHover;
		itemPadding: settingsPluginPopupPadding;
	}
}
settingsPluginPanelPopup: PopupMenu(popupMenuWithIcons) {
	menu: Menu(menuWithIcons) {
		itemFg: settingsPluginPopupText;
		itemFgOver: settingsPluginPopupTextHover;
		itemBg: settingsPluginPopupFill;
		itemBgOver: settingsPluginPopupFillHover;
	}
}
settingsPluginClose: IconButton(boxTitleClose) {
}
settingsPluginBack: IconButton(defaultIconButton) {
	width: 60px;
	height: 54px;
	icon: icon {{ "info/info_back", boxTitleCloseFg }};
	iconOver: icon {{ "info/info_back", boxTitleCloseFgOver }};
	iconPosition: point(11px, -1px);
	rippleAreaPosition: point(6px, 6px);
	rippleAreaSize: 42px;
	ripple: defaultRippleAnimationBgOver;
}
settingsPluginSearchClear: CrossButton(defaultMultiSelectSearchCancel) {
}
settingsPluginPlainRow: SettingsButton(defaultSettingsButton) {
}
settingsPluginPopupRow: SettingsButton(defaultSettingsButton) {
	style: defaultTextStyle;
	textFg: settingsPluginPopupText;
	textFgOver: settingsPluginPopupTextHover;
	textBg: settingsPluginPopupFill;
	textBgOver: settingsPluginPopupFillHover;
	padding: settingsPluginPopupPadding;
	height: 18px;
}
settingsPluginChoice: SettingsButton(defaultSettingsButton) {
	style: semiboldTextStyle;
	textFgOver: windowFgActive;
	padding: margins(11px, 5px, 11px, 5px);
}
settingsPluginLabelMuted: windowSubTextFg;
settingsPluginLabelAccent: windowActiveTextFg;
settingsPluginLabelPositive: groupCallLive1;
settingsPluginLabelAttention: attentionButtonFg;
settingsPluginRowHover: windowBgOver;
settingsPluginRowPressed: windowBgRipple;
settingsPluginChoiceSelected: windowBgActive;
settingsPluginCardFill: windowBgOver;
settingsPluginCardActionOverlay: windowFg;
settingsPluginCardActionHoverAlpha: 12;
settingsPluginCardActionPressedAlpha: 22;
settingsPluginInstallOutlineAlpha: 16;
settingsPluginProxyResetWidth: 38px;
settingsPluginSdkBorderAlpha: 115;
settingsPluginSdkDangerAlpha: 35;
settingsPluginSdkRippleAlpha: 55;
settingsPluginSdkHoverBlend: 0.08;
settingsPluginSdkHoverDuration: 120;
settingsPluginSdkArrowGap: 8px;
settingsPluginSdkLinkArrowSize: 14px;
settingsPluginSdkLinkArrowInset: 12px;

// Fixed reference colors for palette="ovygram" in dark themes.
// Hex literals are stored as strings because style colors follow the theme.
settingsPluginRefPrimaryText: "#F0F7FC";
settingsPluginRefPrimaryFill: "#3375AA";
settingsPluginRefSecondaryText: "#6493BD";
settingsPluginRefSecondaryFill: "#18242F";
settingsPluginRefSecondaryBorder: "#507B9C";
settingsPluginRefDangerText: "#DE7D7A";
settingsPluginRefDangerFill: "#3A2D33";
settingsPluginRefCodeText: "#86A7C5";
settingsPluginRefCodeFill: "#293C4A";

settingsPluginInstallDetailsIcon: icon {{ "menu/file", menuIconFg }};
settingsPluginInstallDetails: SettingsButton(settingsPluginLinkRow) {
	textFg: windowActiveTextFg;
	textFgOver: windowActiveTextFg;
}
