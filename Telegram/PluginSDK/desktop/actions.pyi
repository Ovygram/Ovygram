from collections.abc import Callable, Iterable
from dataclasses import dataclass
from typing import Any, Literal
from .models import Chat, Message
from .ui import WidgetRule

@dataclass(frozen=True)
class Invocation:
    source: str
    account_id: str = ...
    chat: Chat | None = ...
    message: Message | None = ...

class Action:
    name: str
    title: str
    link: str
    def __call__(self, invocation: Invocation | None = None) -> Any: ...
    def add_menu(self, menu: Literal["main", "chat", "profile", "message"], *,
                 kinds: Iterable[Literal["user", "chat", "channel"]] | None = None) -> WidgetRule: ...
    async def configure_shortcut(self) -> bool: ...
    def remove(self) -> None: ...

async def register(name: str, title: str, callback: Callable[[Invocation], Any], *,
                   tray: bool = False, global_shortcut: bool = False, link: bool = False, shortcut: str = "") -> Action: ...
