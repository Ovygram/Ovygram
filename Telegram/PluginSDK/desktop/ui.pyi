from collections.abc import Callable, Iterable
from dataclasses import dataclass
from typing import Any, Literal

from .models import Account, Chat, Message

Width = int | Literal["fit"] | None
Command = dict[str, Any]
Handler = Callable[..., Any]

class ObjectDestroyed(RuntimeError): ...

class Node:
    id: str
    props: dict[str, Any]
    handlers: dict[str, Handler]
    children: tuple[Node, ...]
    def to_json(self) -> dict[str, Any]: ...
    def walk(self) -> Iterable[Node]: ...

class Column(Node):
    def __init__(self, *children: Node | str, width: Width = None, stretch: int | None = None,
                 gap: int | None = None, visible: bool | None = None) -> None: ...

class Card(Column):
    def __init__(self, *children: Node | str, width: Width = None, stretch: int | None = None,
                 gap: int | None = None, visible: bool | None = None, background: str | None = None) -> None: ...

class Progress(Node):
    def __init__(self, value: float = 0.0) -> None: ...

class Divider(Node): ...

class Row(Node):
    def __init__(self, *children: Node | str, align: Literal["top", "center", "bottom"] = "center",
                 spacing: int = 8, width: Width = None, stretch: int | None = None, wrap: bool = False) -> None: ...

class Text(Node):
    def __init__(self, text: Any, align: Literal["left", "center", "right"] = "left",
                 width: Width = None, stretch: int | None = None, *,
                 tone: Literal["normal", "muted", "accent", "positive", "attention"] = "normal",
                 bold: bool = False, color: str | None = None) -> None: ...

class Button(Node):
    def __init__(self, text: Any, on_click: Callable[[], Any] | None = None,
                 width: Width = None, stretch: int | None = None, *, enabled: bool = True,
                 tooltip: str = "", variant: Literal["primary", "secondary", "danger", "trash", "chip", "code", "link",
                                                     "choice"] = "primary",
                 visible: bool | None = None, detail: str = "", selected: bool = False,
                 palette: Literal["theme", "ovygram"] = "theme",
                 colors: dict[str, str] | None = None) -> None: ...

class Input(Node):
    def __init__(self, text: str = "", placeholder: str = "", on_change: Callable[[str], Any] | None = None,
                 width: Width = None, stretch: int | None = None, *, search: bool = False) -> None: ...

class Switch(Node):
    def __init__(self, text: Any, value: bool = False, on_toggle: Callable[[bool], Any] | None = None,
                 width: Width = None, stretch: int | None = None) -> None: ...

class Slider(Node):
    def __init__(self, value: int = 0, on_change: Callable[[int], Any] | None = None,
                 width: Width = None, stretch: int | None = None, *, minimum: int = 0,
                 maximum: int = 255, label: str = "") -> None: ...

class Image(Node):
    def __init__(self, path: str, height: int = 0, width: Width = None, stretch: int | None = None) -> None: ...

class Spacer(Node):
    def __init__(self, height: int, width: Width = None, stretch: int | None = None) -> None: ...

class Canvas(Node):
    def __init__(self, height: int, commands: Iterable[Command] = (),
                 on_click: Callable[[int, int], Any] | None = None,
                 width: Width = None, stretch: int | None = None) -> None: ...

def fill_rect(x: float, y: float, width: float, height: float, color: str, radius: float = 0) -> Command: ...
def line(x1: float, y1: float, x2: float, y2: float, color: str, width: float = 1) -> Command: ...
def ellipse(x: float, y: float, width: float, height: float, color: str) -> Command: ...
def text(x: float, y: float, value: Any, color: str, size: int = 13) -> Command: ...

class Surface:
    kind: str
    id: str
    content: Node
    title: str
    closed: bool
    on_close: Callable[[], Any] | None
    def __init__(self, content: Node | str, title: str = "", width: int = 0, height: int = 0,
                 on_close: Callable[[], Any] | None = None) -> None: ...
    def show(self) -> Surface: ...
    def update(self, node: Node, **props: Any) -> None: ...
    def draw(self, canvas: Canvas, commands: Iterable[Command]) -> None: ...
    def close(self) -> None: ...

class Dialog(Surface):
    footer_action: Button | None
    def __init__(self, content: Node | str, title: str = "", width: int = 0, height: int = 0,
                 on_close: Callable[[], Any] | None = None, *, footer_action: Button | None = None) -> None: ...

class Window(Surface):
    def __init__(self, content: Node | str, title: str = "", width: int = 420, height: int = 480,
                 on_close: Callable[[], Any] | None = None, *, max_content_width: int | None = None) -> None: ...

class ChatBar(Surface):
    def __init__(self, chat: Chat, content: Node | str, on_close: Callable[[], Any] | None = None) -> None: ...

class Section(Surface):
    def __init__(self, content: Node | str, title: str = "", on_close: Callable[[], Any] | None = None,
                 *, max_content_width: int | None = None) -> None: ...

class Insert(Surface):
    def __init__(self, target: dict[str, Any] | str, content: Node | str, *,
                 position: Literal["inside", "before", "after"] = "inside",
                 on_close: Callable[[], Any] | None = None) -> None: ...

class Overlay(Surface):
    def __init__(self, target: dict[str, Any] | str, canvas: Canvas,
                 on_close: Callable[[], Any] | None = None) -> None: ...

ELEMENTS: tuple[str, ...]

class Element:
    name: str
    def hide(self) -> None: ...
    def show(self) -> None: ...
    def on_click(self, callback: Callable[[], Any], replace: bool = False) -> None: ...
    def off_click(self) -> None: ...

def element(name: str) -> Element: ...
def set_colors(colors: dict[str, str]) -> None: ...
def reset_colors() -> None: ...

class WidgetRule:
    id: str
    def remove(self) -> None: ...

@dataclass(frozen=True)
class PanelContext:
    account_id: str
    chat: Chat
    panel: str
    handle: str = ...

class PanelButton(WidgetRule):
    def __init__(self, panel: Literal["chat.top_bar", "compose", "search.actions"], text: str,
                 callback: Callable[[PanelContext], Any], *, tooltip: str = "", width: int = 40,
                 priority: int = 0, enabled: bool = True, visible: bool = True,
                 chat: Chat | None = None, kinds: Iterable[str] | None = None) -> None: ...
    def update(self, text: str | None = None, tooltip: str | None = None, width: int | None = None,
               priority: int | None = None, enabled: bool | None = None, visible: bool | None = None) -> None: ...
    def show(self) -> None: ...
    def hide(self) -> None: ...

def add_panel_button(panel: Literal["chat.top_bar", "compose", "search.actions"], text: str,
                     callback: Callable[[PanelContext], Any], *, tooltip: str = "", width: int = 40,
                     priority: int = 0, enabled: bool = True, visible: bool = True,
                     chat: Chat | None = None, kinds: Iterable[str] | None = None) -> PanelButton: ...

class Placement(WidgetRule):
    def __init__(self, factory: Callable[[str], Node | str], position: Literal["inside", "before", "after"] = "inside",
                 **selector: Any) -> None: ...
    def remove(self) -> None: ...

async def widget_tree(depth: int = 8, root: dict[str, Any] | str | None = None) -> dict[str, Any] | None: ...
async def widget_at_cursor() -> dict[str, Any] | None: ...
async def get_property(widget: dict[str, Any] | str, name: str) -> Any: ...
def set_property(widget: dict[str, Any] | str, name: str, value: Any) -> None: ...
def hide_widgets(**selector: Any) -> WidgetRule: ...
def on_widget_click(callback: Callable[[], Any], replace: bool = False, **selector: Any) -> WidgetRule: ...
def on_key(sequence: str, callback: Callable[[], Any], replace: bool = False,
           element: str | None = None) -> WidgetRule: ...

class ChatDecoration:
    def update(self, commands: Iterable[Command] = (), background: str | None = None) -> None: ...
    def remove(self) -> None: ...

def decorate_chat(chat: Chat | Literal["*"], commands: Iterable[Command] = (),
                  background: str | None = None, account: Account | str | None = None, *,
                  footer_height: int = 0) -> ChatDecoration: ...
def on_compose_change(callback: Callable[[dict[str, Any]], Any]) -> WidgetRule: ...
async def editor_snapshot(chat: Chat, *, kind: Literal["message", "album"] = "message") -> dict[str, Any] | None: ...
async def set_draft(snapshot: dict, text: str, tags: Iterable[dict] = ()) -> bool: ...
async def suggest_draft(snapshot: dict, text: str) -> bool: ...
async def editor_reply(snapshot: dict, message_id: int | None = None) -> bool: ...
async def editor_edit(snapshot: dict, message_id: int) -> bool: ...
async def choose_attachments(snapshot: dict) -> bool: ...
async def reorder_attachments(snapshot: dict, order: Iterable[int]) -> bool: ...
async def set_attachment_caption(snapshot: dict, index: int, caption: str) -> bool: ...
async def compose_state() -> dict[str, Any] | None: ...
def replace_compose_text(start: int, end: int, text: str, select: bool = False) -> None: ...

class MessageDecoration:
    def update(self, commands: Iterable[Command] = (), background: str | None = None) -> None: ...
    def remove(self) -> None: ...

def decorate_message(message: Message, commands: Iterable[Command] = (),
                     background: str | None = None, *, footer_height: int = 0) -> MessageDecoration: ...

class HiddenChats:
    def remove(self) -> None: ...

def hide_chats(chats: Iterable[Chat]) -> HiddenChats: ...
async def compose_text() -> str | None: ...
def set_compose_text(text: str) -> None: ...
def insert_compose_text(text: str) -> None: ...
def set_clipboard(text: str) -> None: ...
def show_dialog(content: Node | str, title: str = "", width: int = 0,
                on_close: Callable[[], Any] | None = None, *, footer_action: Button | None = None) -> Dialog: ...

class MenuContext:
    account_id: str
    chat: Chat | None
    message: Message | None

def add_menu_item(menu: Literal["main", "chat", "profile", "message"], text: str,
                  callback: Callable[[MenuContext], Any],
                  kinds: Iterable[Literal["user", "chat", "channel"]] | None = None) -> WidgetRule: ...
