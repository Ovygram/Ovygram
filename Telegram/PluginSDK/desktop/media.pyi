from collections.abc import Callable
from pathlib import Path
from dataclasses import dataclass
from typing import Literal
from collections.abc import Iterable
from typing import Any
from . import tl
from .models import Account, Attachment, Chat, Progress

async def send_file(chat: Chat, path: str | Path, *, caption: str = "", progress: Callable[[Progress], Any] | None = None, silent: bool = False) -> tl.TLObject: ...
async def download_file(attachment: Attachment, destination: str | Path, *, progress: Callable[[Progress], Any] | None = None) -> Path: ...

async def send_photo(chat: Chat, path: str | Path, *, caption: str = "", progress: Callable[[Progress], Any] | None = None, silent: bool = False) -> tl.TLObject: ...
async def send_voice(chat: Chat, path: str | Path, *, duration: int, waveform: bytes | None = None, progress: Callable[[Progress], Any] | None = None, silent: bool = False) -> tl.TLObject: ...
async def send_video_note(chat: Chat, path: str | Path, *, duration: float, size: int, progress: Callable[[Progress], Any] | None = None, silent: bool = False) -> tl.TLObject: ...

@dataclass(frozen=True)
class AlbumItem:
    path: str | Path
    kind: Literal["photo", "video"] = "photo"
    caption: str = ""
    duration: float = 0
    width: int = 0
    height: int = 0

async def send_album(chat: Chat, items: Iterable[AlbumItem], *, progress: Callable[[Progress], Any] | None = None, silent: bool = False) -> tl.TLObject: ...
async def pick_file(account: Account | str) -> Path | None: ...
async def downloads(account: Account | str) -> list[dict[str, Any]]: ...
async def cancel_download(account: Account | str, entry: dict[str, Any]) -> bool: ...
async def playback(account: Account | str, kind: Literal["song", "voice"] = "song") -> dict[str, Any] | None: ...
async def control_playback(account: Account | str, state: dict[str, Any], action: Literal["play", "pause", "stop", "next", "previous", "seek"], *, position_ms: int | None = None) -> bool: ...
